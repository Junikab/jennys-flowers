{
  "name": "jennys-flowers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "npm run build:prod",
    "build:prod": "vite-ssg build --mode production && npm run check:static -- --environment=production",
    "build:staging": "vite-ssg build --mode staging && npm run check:static -- --environment=staging",
    "check:static": "node scripts/validate-static-build.cjs",
    "lint": "eslint src scripts vite.config.mjs",
    "lint:fix": "npm run lint -- --fix",
    "deploy": "npm run deploy:prod",
    "deploy:prod": "npm run build:prod && gh-pages -d dist",
    "deploy:staging": "npm run build:staging && node scripts/remove-dist-cname.cjs && node scripts/write-staging-deploy-meta.cjs && gh-pages -d dist -r git@github.com:Junikab/Junikab.github.io.git -b gh-pages",
    "cloudinary:export-folder": "node scripts/export-cloudinary-folder.cjs",
    "cloudinary:sync-gallery": "node scripts/sync-cloudinary-gallery.cjs"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "vue": "^3.5.43",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "gh-pages": "6.1.1",
    "globals": "17.13.0",
    "sass": "1.105.1",
    "vite": "7.3.6",
    "vite-ssg": "28.3.0",
    "vue-eslint-parser": "10.4.1"
  }
}
